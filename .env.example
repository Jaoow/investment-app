# Loaded as Java properties from .env.local when the API starts in the repository root.
# Run .\scripts\Setup-Local.ps1 to create this file with a random JWT key.
# These database credentials are only for the isolated local Compose service.
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5433/investmentdb
JDBC_DATABASE_USERNAME=investmentuser
JDBC_DATABASE_PASSWORD=investmentpass
JWT_SECRET_KEY=GENERATE_WITH_SETUP_LOCAL
# Fill in your own brapi token to test market data and contribution suggestions.
BRAPI_API_TOKEN=
SERVER_PORT=8086
INVESTIZE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
